# Copy to .env for local use. NEVER commit .env.
OPENAI_API_KEY=
GEMINI_API_KEY=
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1

# Optional model overrides (provider model IDs change; check current names)
OPENAI_MODEL=gpt-4o-mini
GEMINI_MODEL=gemini-flash-latest
KIMI_MODEL=moonshot-v1-8k

# Public deployments: keep false so visitors must bring their own key.
# Set true only if you accept paying for every visitor's requests.
ALLOW_SERVER_KEYS=false
MAX_QUESTION_CHARS=300
MAX_SAMPLES=12
LLM_TIMEOUT_SECONDS=20
